# Databricks Configuration
DATABRICKS_HOST=your-workspace-url.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/your-warehouse-id
DATABRICKS_TOKEN=dapi...

# Entra ID Configuration
TENANT_ID=your-tenant-id
CLIENT_ID=your-client-id
CLIENT_SECRET=your-client-secret
REDIRECT_URI=http://localhost:8501

# Set to 'true' ONLY for local development to bypass Entra ID authentication
# You must also set ENVIRONMENT=development for mock authentication to work.
ENABLE_MOCK_AUTH=false
ENVIRONMENT=production

# Set to 'true' to use built-in demo data instead of a live SQL Warehouse.
# Useful for local UI development — no Databricks connection required.
DEMO_DATA=false

# Comma-separated Entra ID group object IDs whose members may edit business names.
# In mock/demo mode the hardcoded group IDs work directly (e.g. finance_dept_id).
EDITOR_GROUPS=finance_dept_id

# SMTP — used for comment notifications and steward reply emails.
# Leave blank to disable email sending (comments are still saved).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Local DuckDB cache — two-file architecture:
#
#   DUCKDB_PATH        — catalog file, written atomically by sync_metadata.py on each sync.
#                        Contains: tables_metadata, columns_metadata, permissions_cache,
#                        lineage_cache, object_tags, audit_log.
#
#   USER_DATA_PATH     — user data file, owned exclusively by the app (never touched by sync).
#                        Derived automatically from DUCKDB_PATH by replacing ".duckdb" with
#                        "_user_data.duckdb" (e.g. dict.duckdb → dict_user_data.duckdb).
#                        Contains: comments, business_name_overrides, audit_log.
#
# When DUCKDB_PATH is set and the catalog file exists, the app reads/writes from DuckDB
# instead of going across the network to the SQL Warehouse (much faster).
# Leave blank to always use the Databricks SQL Warehouse.
DUCKDB_PATH=dictionary_cache.duckdb

# Comma-separated Entra ID group object IDs whose members have admin access.
# Admin users can view the admin dashboard (statistics and audit logs).
# Leave blank to disable the admin feature for all users.
ADMIN_GROUPS=
