# Databricks Configuration
DATABRICKS_HOST=your-workspace-url.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/your-warehouse-id
DATABRICKS_TOKEN=dapi...

# Entra ID Configuration
TENANT_ID=your-tenant-id
CLIENT_ID=your-client-id
CLIENT_SECRET=your-client-secret
REDIRECT_URI=http://localhost:8501

# Set to 'true' ONLY for local development to bypass Entra ID authentication
# You must also set ENVIRONMENT=development for mock authentication to work.
ENABLE_MOCK_AUTH=false
ENVIRONMENT=production

# Set to 'true' to use built-in demo data instead of a live SQL Warehouse.
# Useful for local UI development — no Databricks connection required.
DEMO_DATA=false

# Comma-separated Entra ID group object IDs whose members may edit business names.
# In mock/demo mode the hardcoded group IDs work directly (e.g. finance_dept_id).
EDITOR_GROUPS=finance_dept_id

# SMTP — used for comment notifications and steward reply emails.
# Leave blank to disable email sending (comments are still saved).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Local DuckDB cache — two-file architecture:
#
#   DUCKDB_PATH        — catalog file, written atomically by sync_metadata.py on each sync.
#                        Contains: tables_metadata, columns_metadata, permissions_cache,
#                        lineage_cache, object_tags, audit_log.
#
#   USER_DATA_PATH     — user data file, owned exclusively by the app (never touched by sync).
#                        Derived automatically from DUCKDB_PATH by replacing ".duckdb" with
#                        "_user_data.duckdb" (e.g. dict.duckdb → dict_user_data.duckdb).
#                        Contains: comments, business_name_overrides, audit_log.
#
# When DUCKDB_PATH is set and the catalog file exists, the app reads/writes from DuckDB
# instead of going across the network to the SQL Warehouse (much faster).
# Leave blank to always use the Databricks SQL Warehouse.
DUCKDB_PATH=dictionary_cache.duckdb

# ── Business friendly-name source (Unity Catalog) ─────────────────────────────
# The dictionary reads bilingual friendly names + definitions for each table
# from a UC reference table on every sync, and writes approved edits back via
# the sidecar. Both the table name and the column names are configurable so the
# source can move or be renamed without a code change. Defaults reflect the
# current contract; override per environment if yours differs.
BUSINESS_NAMES_TABLE=governance.dictionary.business_names
BUSINESS_NAMES_COL_FULL_NAME=full_name
BUSINESS_NAMES_COL_NAME_EN=friendly_name_eng
BUSINESS_NAMES_COL_NAME_FR=friendly_name_fr
BUSINESS_NAMES_COL_DEF_EN=field_definition_eng
BUSINESS_NAMES_COL_DEF_FR=field_definition_fr

# Comma-separated Entra ID group object IDs whose members have admin access.
# Admin users can view the admin dashboard (statistics and audit logs).
# In mock/dev mode, the "Admin" department has group "mock_admin_group" built in.
ADMIN_GROUPS=mock_admin_group

# Comma-separated Entra ID group object IDs whose members can trigger pipelines.
# These users see a "Pipelines" tab to run Databricks / ADF / ADO pipelines.
# Admins always see the tab regardless of this setting.
# In mock/dev mode: mock_admin_group gives the Admin user pipeline access too.
PIPELINE_GROUPS=mock_admin_group

# Service principal credentials used exclusively for pipeline execution.
# This SP needs: Databricks Contributor (or Operator), ADF Contributor, ADO Build executor.
PIPELINE_SP_TENANT_ID=
PIPELINE_SP_CLIENT_ID=
PIPELINE_SP_CLIENT_SECRET=

# ── Sidecar sync worker (`python -m src.sync.daemon`) ───────────────────────
# All optional — defaults below match the daemon's runtime defaults. See
# docs/runbooks/sync-worker.md for the full operations reference.
#
# SYNC_POLL_ACTIVE_S=5         # sleep between cycles after a productive cycle
# SYNC_POLL_IDLE_S=30          # sleep between cycles after an empty cycle
# SYNC_DR_EVERY_N=20           # run DR resync every N cycles (~10 min active)
# SYNC_STALE_ROW_S=300         # rows in 'syncing' >this flip back to 'pending'
# SYNC_HEALTHZ_PORT=8765       # /healthz port; set 0 to disable
# SYNC_HEALTHZ_TIMEOUT_S=60    # heartbeat age above which /healthz returns 503
# LOG_LEVEL=INFO               # daemon log level — DEBUG for verbose cycle logs
